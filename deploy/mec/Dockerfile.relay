FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . && useradd --create-home anchor && mkdir -p /var/lib/anchor && chown anchor /var/lib/anchor
COPY hardware/ship-gateway-pi5/sync/anchor_relay.py ./hardware/ship-gateway-pi5/sync/
COPY deploy/mec/start_relay.py ./deploy/mec/
USER anchor
ENTRYPOINT ["python", "/app/deploy/mec/start_relay.py"]

[basic.config]
cseType=MN
cseID=__CSE_ID__
cseName=__CSE_NAME__
cseHost=__PUBLIC_HOST__
httpPort=__HTTP_PORT__
networkInterface=0.0.0.0
databaseType=tinydb
adminID=CAdmin
serviceProviderID=//anchor.ctrlsea

[cse]
enableRemoteCSE=true
requestExpirationDelta=3

[cse.security]
enableACPChecks=true

[cse.registration]
allowedCSROriginators=/id-ship,/id-edge,/id-edge-b,/id-in
checkLiveliness=false
unregisterWhenStopping=false

[resource.cnt]
; Application/firmware capacity guards pause new writes; never silently evict.
enableLimits=false

[database.tinydb]
cacheSize=0
writeDelay=0

[mqtt]
enable=false
address=127.0.0.1
port=1883

[logging]
level=warn
enableFileLogging=false

[textui]
enable=false
[webui]
enable=false

[cse.registrar]
address=__REGISTRAR_URL__
cseID=/id-in
resourceName=cse-in
INCSEcseID=/id-in

[http.security]
useTLS=true
verifyCertificate=true
tlsVersion=auto
caCertificateFile=${ANCHOR_TLS_DIR}/server.crt
caPrivateKeyFile=${ANCHOR_TLS_DIR}/server.key

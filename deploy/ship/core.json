{
  "role": "ship",
  "vessel_id": "ship-001",
  "bind": "0.0.0.0",
  "port": 8790,
  "notify_url": "https://127.0.0.1:8790/notify",
  "token_file": "../../.runtime-ship/api-token",
  "status_token_file": "../../.runtime-ship/status-token",
  "direct_shore": false,
  "scan_seconds": 2,
  "batch_size": 40,
  "nodes": {
    "ship": {
      "url": "https://127.0.0.1:8080",
      "root": "cse-ship",
      "csi": "/id-ship",
      "rvi": "3",
      "timeout": 3,
      "ca": "../../.runtime-ship/tls/ca.crt"
    },
    "edge": {
      "url": "https://edge.local:8080",
      "root": "cse-edge",
      "csi": "/id-edge",
      "rvi": "3",
      "timeout": 3,
      "ca": "../../.runtime-ship/tls/ca.crt"
    },
    "shore": {
      "url": "https://shore.local:8080",
      "root": "cse-in",
      "csi": "/id-in",
      "rvi": "3",
      "timeout": 3,
      "ca": "../../.runtime-ship/tls/ca.crt"
    }
  },
  "tls_ca": "../../.runtime-ship/tls/ca.crt",
  "tls_cert": "../../.runtime-ship/tls/server.crt",
  "tls_key": "../../.runtime-ship/tls/server.key"
}

[Unit]
Description=ANCHOR %i dashboard
After=network-online.target time-sync.target anchor-cse@%i.service
Wants=network-online.target
ConditionPathExists=/opt/anchor/deploy/%i/run.sh

[Service]
User=pi
WorkingDirectory=/opt/anchor
ExecStart=/opt/anchor/deploy/%i/run.sh dashboard
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

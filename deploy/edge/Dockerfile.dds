FROM python:3.12-slim
ARG CYCLONEDDS_REV=179ae6fe82c9954c73aa5e31bd28f994a853dcf1
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates \
    && git clone --branch 11.1.0 --depth 1 https://github.com/eclipse-cyclonedds/cyclonedds.git /tmp/cyclonedds \
    && test "$(git -C /tmp/cyclonedds rev-parse HEAD)" = "$CYCLONEDDS_REV" \
    && cmake -S /tmp/cyclonedds -B /tmp/dds-build -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_INSTALL_PREFIX=/opt/cyclonedds -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF -DENABLE_SECURITY=OFF \
    && cmake --build /tmp/dds-build --parallel 2 && cmake --install /tmp/dds-build \
    && rm -rf /tmp/cyclonedds /tmp/dds-build /var/lib/apt/lists/*
ENV CYCLONEDDS_HOME=/opt/cyclonedds
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-binary=cyclonedds '.[dds]' && useradd --uid 10001 --create-home anchor
USER 10001
ENTRYPOINT ["anchor-dds"]
CMD ["--config", "/config/dds.container.json", "run"]

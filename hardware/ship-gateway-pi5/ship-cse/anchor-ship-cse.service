[Unit]
After=time-sync.target
Wants=time-sync.target
Description=ANCHOR ship MN-CSE (ACME)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=pi
WorkingDirectory=/home/pi/anchor/ship-cse
ExecStartPre=/usr/bin/python3 /home/pi/anchor/ship-cse/check_db.py
ExecStart=/home/pi/anchor/venv/bin/acmecse --config acme.ini --headless
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

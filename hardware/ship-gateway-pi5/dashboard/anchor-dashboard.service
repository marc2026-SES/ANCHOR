[Unit]
Description=ANCHOR ship dashboard (camera + sensors from MN-CSE)
After=network-online.target anchor-ship-cse.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/anchor/dashboard
ExecStart=/usr/bin/python3 /home/pi/anchor/dashboard/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=ANCHOR ship-to-shore sync agent + link monitor
After=network-online.target anchor-ship-cse.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/anchor/sync
ExecStart=/usr/bin/python3 -u /home/pi/anchor/sync/anchor_sync.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

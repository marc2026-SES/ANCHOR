# Compatibility name. Run this OR anchor-core@ship, never both.
[Unit]
Description=ANCHOR ship real hardware core (replaces old FIFO sync)
After=network-online.target anchor-ship-cse.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/opt/anchor
ExecStart=/opt/anchor/.venv/bin/anchor --config /opt/anchor/deploy/ship.json serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
